# ============================================================
# Aacharya LMS — Backend Environment Configuration
# ============================================================

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ============================================================
# MongoDB
# ============================================================

# Local development
MONGODB_URI=mongodb://127.0.0.1:27017/aacharya_lms

# Optional: Custom DNS resolvers for MongoDB Atlas SRV lookups.
# Comma-separated IP addresses.
# Example: MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
#
# Leave unset to use the application's configured defaults.
# MONGODB_DNS_SERVERS=

# ============================================================
# Authentication & Security
# ============================================================

# Use different, cryptographically random secrets in production.
# Production secrets must contain at least 32 characters.

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_RESET_OTP_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters

# Cookie policy: strict, lax, or none.
# The production default is none for separately hosted frontend/API.
# SameSite=none requires HTTPS and Secure cookies.
COOKIE_SAME_SITE=strict

# Keep this secret stable to preserve student-import idempotency.
STUDENT_IMPORT_IDEMPOTENCY_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# ============================================================
# Cloudinary — File Storage
# ============================================================

# Configure all three variables together.
# Leave all three empty to disable Cloudinary during local development.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# Transactional Email — Brevo
# ============================================================

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aacharya LMS
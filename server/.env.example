NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/aacharya_lms
LOG_LEVEL=info

# Use distinct random secrets in production (at least 32 characters each).
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_OTP_SECRET=replace-with-a-third-random-secret-at-least-32-characters

# Cookie policy: strict/lax/none. Production defaults to none for separately hosted frontend/API.
# COOKIE_SAME_SITE=none requires HTTPS and Secure cookies.
COOKIE_SAME_SITE=strict

# Student import idempotency HMAC secret. Keep stable to preserve replay behavior.
STUDENT_IMPORT_IDEMPOTENCY_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional transactional email delivery (Brevo).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aacharya LMS
